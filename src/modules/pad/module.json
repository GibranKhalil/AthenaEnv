{
  "id": "pad",
  "name": "Gamepad Controller (Pads)",
  "description": "Controller support for PS2 DualShock 2 and digital gamepads: buttons, analog sticks, rumble (vibration), and connection states.",
  "category": "Input",
  "version": "1.0.0",
  "required": false,
  "default": true,
  "sources": [
    "pad_hw.c",
    "ath_pad.c"
  ],
  "includes": [
    "."
  ],
  "dependencies": {
    "modules": [
      "system"
    ],
    "iop": [
      "sio2man",
      "padman"
    ],
    "ee_libs": [
      "-lpad"
    ]
  },
  "quickjs": {
    "module_name": "Pads",
    "global_alias": "Pads",
    "init_func": "athena_pads_init",
    "header": "ath_pad.h"
  },
  "types": "pad.d.ts"
}
